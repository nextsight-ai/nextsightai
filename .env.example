# Application
APP_NAME=NextSight AI
APP_VERSION=1.4.1
DEBUG=false
DEMO_MODE=false

# Security
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEFAULT_ADMIN_PASSWORD=admin123

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nextsight
USE_DATABASE_AUTH=true

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# OAuth (Optional)
OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_URL=https://gitlab.com
OAUTH_REDIRECT_BASE=http://localhost:3000

# Kubernetes
K8S_CONFIG_PATH=
K8S_IN_CLUSTER=false
K8S_HOST_OVERRIDE=

# Optimization Metrics Source
# Options: "metrics-server" (default, lightweight) or "prometheus" (more accurate, historical data)
OPTIMIZATION_METRICS_SOURCE=metrics-server
PROMETHEUS_NAMESPACE=monitoring
PROMETHEUS_RELEASE_NAME=prometheus-stack

# Jenkins (Optional)
JENKINS_URL=http://localhost:8080
JENKINS_USERNAME=
JENKINS_TOKEN=

# AI Provider (groq, gemini, anthropic)
AI_PROVIDER=groq

# Groq (FREE - recommended)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
